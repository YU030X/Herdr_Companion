{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdr Companion",
  "version": "0.1.0",
  "identifier": "dev.herdr.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Herdr Companion",
        "width": 380,
        "height": 520,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
