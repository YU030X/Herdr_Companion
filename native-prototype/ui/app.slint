import { Button, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <string> connection-label: "连接中";
    in property <string> connection-detail: "正在读取 Herdr";
    in property <string> protocol-label: "Protocol –";
    in property <string> workspace-title: "全部工作区";
    in property <[string]> workspace-tabs;
    in property <string> agents-text: "等待 Snapshot…";
    in property <bool> stale: false;
    in property <int> selected-workspace: 0;
    callback retry-clicked();
    callback workspace-clicked(int);

    preferred-width: 360px;
    preferred-height: 480px;
    min-width: 320px;
    min-height: 400px;
    title: "Herdr Companion · Native Prototype";

    Rectangle {
        background: #141414;
        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 42px;
                background: #181818;
                HorizontalLayout {
                    padding-left: 13px;
                    padding-right: 10px;
                    alignment: center;
                    Text {
                        text: "H  Herdr Companion";
                        color: #f0f0f0;
                        font-size: 14px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 38px;
                background: #141414;
                tabs-scroll := ScrollView {
                    x: 13px;
                    width: parent.width - 26px;
                    height: parent.height;
                    viewport-width: max(self.visible-width, tabs.preferred-width);
                    viewport-height: self.visible-height;

                    tabs := HorizontalLayout {
                        spacing: 5px;
                        alignment: center;
                        for tab[index] in workspace-tabs: Rectangle {
                            height: 26px;
                            width: max(54px, tab-label.preferred-width + 20px);
                            background: index == selected-workspace ? #252525 : #1d1d1d;
                            border-radius: 7px;
                            tab-label := Text {
                                text: tab;
                                color: index == selected-workspace ? #f0f0f0 : #bababa;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.workspace-clicked(index); }
                                scroll-event(event) => {
                                    if (event.delta-y != 0 && event.delta-x == 0) {
                                        tabs-scroll.viewport-x = max(
                                            -(tabs-scroll.viewport-width - tabs-scroll.visible-width),
                                            min(0px, tabs-scroll.viewport-x + event.delta-y)
                                        );
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #1d1d1d;
                border-radius: 14px;
                border-width: 1px;
                border-color: #292929;
                HorizontalLayout {
                    padding: 13px;
                    alignment: center;
                    Text {
                        text: workspace-title;
                        color: #f0f0f0;
                        font-size: 15px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                visible: stale;
                height: 32px;
                background: #2b2620;
                border-radius: 7px;
                Text {
                    text: "Snapshot 已过期 · 显示最后一次快照";
                    color: #e8c28a;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                background: #181818;
                border-radius: 10px;
                border-width: 1px;
                border-color: #262626;
                vertical-stretch: 1;
                agents-scroll := ScrollView {
                    x: 13px;
                    y: 13px;
                    width: parent.width - 26px;
                    height: parent.height - 26px;
                    viewport-width: self.visible-width;
                    viewport-height: max(self.visible-height, agents-label.preferred-height);

                    agents-label := Text {
                        width: parent.width;
                        text: agents-text;
                        color: #bababa;
                        font-size: 12px;
                        vertical-alignment: top;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 38px;
                background: #181818;
                HorizontalLayout {
                    padding-left: 13px;
                    padding-right: 13px;
                    alignment: center;
                    Text {
                        text: connection-label == "已连接"
                            ? "●  " + connection-label
                            : "●  " + connection-label + " · " + connection-detail;
                        color: connection-label == "已连接" ? #3fa266 : #bababa;
                        font-size: 11px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: protocol-label;
                        color: #6c6c6c;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Button {
                        visible: connection-label != "已连接";
                        enabled: connection-label != "连接中";
                        text: "重试";
                        clicked => { root.retry-clicked(); }
                    }
                }
            }
        }
    }
}
